# Task 4 - Rate limiting & model failover. Copy to .env and adjust.

# --- Rate limiter ----------------------------------------------------------
# On-disk SQLite file holding the sliding window.
RATE_LIMIT_DB=gateway.db
RATE_LIMIT_TOKENS=50000
RATE_LIMIT_WINDOW_SECONDS=60

# --- Routing ---------------------------------------------------------------
# Hard deadline on each provider attempt. Blowing it fails over.
ROUTER_TIMEOUT_MS=3000

# --- Primary provider ------------------------------------------------------
# Leave PRIMARY_API_KEY empty to use the built-in mock, which needs no network.
PRIMARY_NAME=primary
PRIMARY_BASE_URL=https://api.openai.com/v1
PRIMARY_API_KEY=
PRIMARY_MODEL=gpt-4o-mini

# Mock-only knobs, for demonstrating failover by hand.
# PRIMARY_BEHAVIOUR: ok | rate_limited | unavailable
PRIMARY_BEHAVIOUR=ok
PRIMARY_DELAY_MS=0

# --- Fallback provider -----------------------------------------------------
FALLBACK_NAME=fallback
FALLBACK_BASE_URL=https://api.anthropic.com/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=claude-sonnet-5

# --- Tenants ---------------------------------------------------------------
# Comma-separated allowlist of tenant API keys. Leave empty to accept any
# non-empty bearer token and treat it as its own tenant (demo mode).
GATEWAY_API_KEYS=

# --- Server ----------------------------------------------------------------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8100
GATEWAY_LOG_LEVEL=INFO
