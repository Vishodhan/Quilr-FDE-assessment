# Task 2 - MCP security gateway. Copy to .env and adjust.

# --- Gateway ---------------------------------------------------------------
# Bearer tokens the gateway will accept, as "token:role" pairs, comma separated.
# Roles: admin | viewer. The token may itself contain colons (split is on the last one).
# Leave unset to fall back to the demo tokens shown below.
GATEWAY_TOKENS=admin-token-abc123:admin,viewer-token-xyz789:viewer

# Where authorized traffic is forwarded.
GATEWAY_UPSTREAM_URL=http://127.0.0.1:9001/mcp

# Credential the gateway presents to the upstream. The client's own token is
# never relayed. Leave blank to forward with no Authorization header.
GATEWAY_UPSTREAM_TOKEN=upstream-service-token

# Path the gateway listens on, and how long it waits for the upstream.
GATEWAY_LISTEN_PATH=/mcp
GATEWAY_UPSTREAM_TIMEOUT=30

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=9000
GATEWAY_LOG_LEVEL=INFO

# --- Mock downstream MCP server -------------------------------------------
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=9001
