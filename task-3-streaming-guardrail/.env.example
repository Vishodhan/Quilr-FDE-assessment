# Task 3 - LLM gateway streaming guardrail. Copy to .env and adjust.

# --- Provider --------------------------------------------------------------
# mock     : offline, deterministic, splits its reply mid-PII on purpose (default)
# upstream : any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=mock

# Only read when LLM_PROVIDER=upstream.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# --- Mock provider ---------------------------------------------------------
# Characters per emitted chunk. 1-4 guarantees PII straddles chunk boundaries.
MOCK_CHUNK_SIZE=4
# Pause between chunks, to imitate a real token stream when you watch it by eye.
MOCK_CHUNK_DELAY_MS=0

# --- Server ----------------------------------------------------------------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=INFO
